# --- CONFIGURATION DE LA BASE DE DONNÉES (MYSQL) ---
DB_NAME=nom_de_votre_base_de_donnees
DB_USER=votre_utilisateur_mysql
DB_PASSWORD=votre_mot_de_passe_mysql
DB_HOST=127.0.0.1
DB_PORT=3306

# --- SÉCURITÉ APPLICATIVE ---
# Générez une clé robuste pour la production (ex: via python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=cle-secrete-django-obligatoire
DEBUG=True

# --- CONFIGURATION DES EMAILS (PRODUCTION HORS DEV LOCAL) ---
# Requis uniquement si DEBUG=False
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-d-application
